# TrailFinder UA — шаблон змінних середовища
# Скопіюйте цей файл у .env і заповніть своїми значеннями
# НІКОЛИ не додавайте .env у Git-репозиторій!

# ── База даних PostgreSQL + PostGIS ──────────────────────────────────────────
DB_NAME=trailfinder_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# ── Django ───────────────────────────────────────────────────────────────────
# Згенерувати: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-replace-me-in-production-use-env-var
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1
